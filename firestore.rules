rules_version = '2';

// CRSC club rules.
//
// This is a community app for a casual sports club: anyone with the link can
// read the lists and add/edit sign-ups (the same trust level as the public
// Google Sheet the club used before, but with structure and history).
//
// Basic guardrails:
//  - signup documents must have the expected shape and small field sizes
//  - events and config can be written by anyone with the link; the exec PIN
//    in the app is a convenience gate, not cryptographic security. If the
//    club ever needs hard security, add Firebase Auth + per-exec accounts.

service cloud.firestore {
  match /databases/{database}/documents {

    match /config/main {
      allow read: if true;
      allow write: if true;
    }

    // Player registry: one doc per device, written at registration.
    match /players/{playerId} {
      allow read: if true;
      // A duplicate profile has to be removable. Without this the rule below
      // refuses its own deletes: a delete carries no data, so the name check
      // can never pass.
      allow delete: if true;
      allow create, update: if
        request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (!('email' in request.resource.data) || request.resource.data.email.size() <= 100)
        && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 30)
        && (!('insta' in request.resource.data) || request.resource.data.insta.size() <= 60)
        && (!('photo' in request.resource.data) || request.resource.data.photo.size() <= 60000)
        // Playing level: one of the four grades, or cleared.
        && (!('level' in request.resource.data) || request.resource.data.level == null
            || (request.resource.data.level is int
                && request.resource.data.level >= 1 && request.resource.data.level <= 4));
    }

    // Received e-transfers, written by the Gmail matcher script. The app
    // marks the ones that reconcile on their own; execs confirm the rest
    // from the Payments screen. `message` is the note the sender typed —
    // it is read for the names of people they paid for, so it is kept short.
    match /payments/{paymentId} {
      allow read: if true;
      allow create, update: if
        (!('sender' in request.resource.data) || request.resource.data.sender.size() <= 100)
        && (!('message' in request.resource.data) || request.resource.data.message.size() <= 300)
        && (!('matchedTo' in request.resource.data) || request.resource.data.matchedTo.size() <= 200);
      allow delete: if true;
    }

    // What each person still owes for one night, published by the app so the
    // Gmail matcher can settle transfers while nobody has the app open. It is
    // derived data — the app can always recompute it from the sign-ups.
    match /dues/{eventId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if request.resource.data.date is string
        && request.resource.data.date.size() <= 20;
    }

    // Removal log: append-only proof trail. Anyone can add a record (the
    // app writes one whenever a name leaves a list) and read it back;
    // nobody can edit or delete an existing record from the client.
    match /removals/{removalId} {
      allow read: if true;
      allow create: if
        request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60;
      allow update, delete: if false;
    }

    // What the execs did: marked paid, granted a pass, graded a player,
    // deleted an account. Append-only for the same reason the removal log is:
    // a record you can edit afterwards answers nothing.
    match /log/{entryId} {
      allow read: if true;
      allow create: if
        request.resource.data.what is string
        && request.resource.data.what.size() > 0
        && request.resource.data.what.size() <= 300
        && (!('by' in request.resource.data) || request.resource.data.by.size() <= 60);
      allow update, delete: if false;
    }

    // Refund requests: somebody who paid, then could not come, gave up their
    // spot and is owed their money back. Unlike the logs this one can be
    // updated, because an exec has to be able to mark it dealt with — and a
    // refund nobody can close is a list that grows for ever.
    match /refunds/{refundId} {
      allow read: if true;
      allow create, update: if
        request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 60
        && (!('email' in request.resource.data) || request.resource.data.email.size() <= 100)
        && (!('settledBy' in request.resource.data) || request.resource.data.settledBy.size() <= 60);
      allow delete: if true;
    }

    // Which reminders have already gone out for a night, kept by the Gmail
    // script so it is the only thing that sends and nobody is chased twice.
    match /reminders/{eventId} {
      allow read: if true;
      allow create, update: if request.resource.data.date is string
        && request.resource.data.date.size() <= 20;
      allow delete: if true;
    }

    match /events/{eventId} {
      allow read: if true;
      allow write: if true;

      match /signups/{signupId} {
        allow read: if true;
        allow delete: if true;
        allow create, update: if
          request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && (!('insta' in request.resource.data) || request.resource.data.insta.size() <= 60)
          && (!('email' in request.resource.data) || request.resource.data.email.size() <= 100)
          && (!('phone' in request.resource.data) || request.resource.data.phone.size() <= 30)
          && (!('photo' in request.resource.data) || request.resource.data.photo.size() <= 60000);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
